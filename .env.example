# Pooler en modo transacción (runtime de la app)
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-1-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler en modo sesión / conexión directa (requerida por Prisma Migrate)
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-1-xxxx.pooler.supabase.com:5432/postgres"

# Clave de la API de Groq (https://console.groq.com) — nunca exponer en el navegador
GROQ_API_KEY=""
