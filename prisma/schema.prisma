// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Enum_Role {
  ADMIN
  USER
}

enum Enum_RolMensaje {
  USUARIO
  ASISTENTE
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Enum_Role @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions       Session[]
  conversaciones Conversacion[]
}

// Sesión de autenticación: el token se guarda en una cookie httpOnly del
// navegador y se valida contra este registro en cada request protegido.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Una conversación del usuario con el asistente de IA.
model Conversacion {
  id        String   @id @default(cuid())
  titulo    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario   User   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  mensajes Mensaje[]
}

// Un mensaje dentro de una conversación: del usuario o del asistente.
model Mensaje {
  id        String          @id @default(cuid())
  rol       Enum_RolMensaje
  contenido String
  createdAt DateTime        @default(now())

  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  conversacionId String
}

// Configuración editable del asistente. Es una tabla de una sola fila
// (id fijo "default"), para que el ADMIN pueda cambiar el System Prompt
// desde el panel sin modificar código.
model ConfiguracionAsistente {
  id           String   @id
  systemPrompt String
  updatedAt    DateTime @updatedAt
}
